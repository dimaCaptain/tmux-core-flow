#!/usr/bin/env python3
"""Claude Code PreToolUse hook → deterministic autoapprove.

Reads the tool call as JSON on stdin and decides, from a policy file, whether to
auto-approve it. No terminal parsing, no key injection, no timing races — the
decision is made from the exact `tool_name` + `tool_input` before any prompt is
shown. See `policy_path` for where the rules are read from.

Scoping safeguard
-----------------
Auto-approval is active for any Claude session running inside tmux (detected via
$TMUX). Outside tmux the hook stays transparent and permission prompts behave
normally. FLOW_AUTOAPPROVE=1/0 forces it on/off for a single session. Dangerous
calls always defer to you via `always_ask`, regardless of scope. See
`enabled_for` for the precise rule.

Contract
--------
- stdin:  {"tool_name": "...", "tool_input": {...}, ...}
- stdout: {"hookSpecificOutput": {"hookEventName": "PreToolUse",
            "permissionDecision": "allow"|"ask", "permissionDecisionReason": "..."}}
           or nothing at all (transparent → default prompt behaviour).
- Always exits 0. Any error → emit nothing, so a bug here can never block agents.

Wired up by install.sh as ~/.local/bin/flow-approve, registered in
~/.claude/settings.json under hooks.PreToolUse.
"""
from __future__ import annotations

import json
import os
import sys

# Resolve the repo root whether run directly or via the ~/.local/bin symlink
# (realpath follows the symlink back to bin/ inside the repo).
_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
_LIB = os.path.join(_ROOT, "lib")
if _LIB not in sys.path:
    sys.path.insert(0, _LIB)

import flow_policy as policy  # noqa: E402

USER_POLICY = os.path.expanduser("~/.config/tmux-core-flow/policy.yaml")
EXAMPLE_POLICY = os.path.join(_ROOT, "config", "policy.example.yaml")


def policy_path(env) -> str:
    """Where to read rules from, most specific first.

    1. $FLOW_POLICY            — explicit override (used by the tests)
    2. ~/.config/tmux-core-flow/policy.yaml — your rules; keep them out of git
    3. config/policy.example.yaml           — the shipped starting point

    Keeping your real deny-list outside the repo is what lets this repo be
    public while your rules stay yours.
    """
    override = env.get("FLOW_POLICY")
    if override:
        return override
    if os.path.exists(USER_POLICY):
        return USER_POLICY
    return EXAMPLE_POLICY


def evaluate(event: dict, rules: dict, enabled: bool) -> dict | None:
    """Pure decision core. Returns a hookSpecificOutput dict, or None for 'stay
    transparent' (no output → Claude falls back to its default prompt)."""
    if not enabled:
        return None
    tool_name = event.get("tool_name")
    if not tool_name:
        return None
    tool_input = event.get("tool_input") or {}
    decision = policy.decide(tool_name, tool_input, rules)
    if decision == policy.ALLOW:
        reason = "auto-approved by tmux-core-flow policy"
    else:
        reason = "matched always_ask rule — deferring to you"
    return {
        "hookEventName": "PreToolUse",
        "permissionDecision": decision,
        "permissionDecisionReason": reason,
    }


def enabled_for(env) -> bool:
    """Auto-approve is active for any agent running inside tmux.

    Priority:
      FLOW_AUTOAPPROVE=1  → force on  (any session, even outside tmux)
      FLOW_AUTOAPPROVE=0  → force off (escape hatch for a given session)
      otherwise           → on when inside tmux ($TMUX set), off elsewhere.

    Dangerous calls still defer to you via always_ask regardless of this.
    """
    v = env.get("FLOW_AUTOAPPROVE")
    if v == "1":
        return True
    if v == "0":
        return False
    return bool(env.get("TMUX"))


def main() -> int:
    try:
        raw = sys.stdin.read()
        event = json.loads(raw)
    except Exception:
        return 0  # malformed input → transparent, never block the agent
    try:
        rules = policy.load(policy_path(os.environ))
    except Exception:
        rules = {"always_ask": []}
    try:
        decision = evaluate(event, rules, enabled_for(os.environ))
    except Exception:
        decision = None
    if decision is not None:
        json.dump({"hookSpecificOutput": decision}, sys.stdout)
    return 0


if __name__ == "__main__":
    sys.exit(main())
